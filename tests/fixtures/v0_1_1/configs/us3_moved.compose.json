{
  "name": "app",
  "networks": {
    "default": {
      "ipam": {},
      "name": "app_default"
    }
  },
  "services": {
    "cache": {
      "command": null,
      "entrypoint": null,
      "image": "valkey/valkey:latest",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "2",
          "target": 6379
        }
      ],
      "pull_policy": "never",
      "volumes": [
        {
          "source": "cache-data",
          "target": "/data",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "web": {
      "command": null,
      "entrypoint": null,
      "image": "valkey/valkey:latest",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "8080",
          "target": 6379
        }
      ],
      "pull_policy": "never"
    }
  },
  "volumes": {
    "cache-data": {
      "name": "app_cache-data"
    }
  }
}
